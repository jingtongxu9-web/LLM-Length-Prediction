{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bayesian-sequential-full-train-report-v1",
  "title": "Bayesian Sequential full-Train trace collection report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collection_id",
    "collection_config_sha256",
    "scientific_contract_sha256",
    "source_prompt_manifest_sha256",
    "status",
    "expected_trace_count",
    "valid_trace_count",
    "missing_trace_count",
    "completion_fraction",
    "valid_prompt_family_count",
    "valid_task_length_cell_count",
    "by_stop_reason",
    "by_task_length",
    "by_temperature",
    "by_seed",
    "censoring_rate",
    "total_observed_tokens",
    "total_duration_ms",
    "total_trace_bytes",
    "total_trace_gib",
    "peak_cuda_allocated_bytes",
    "peak_cuda_reserved_bytes",
    "projected_remaining_duration_ms",
    "new_trace_count_this_run",
    "resumed_trace_count_this_run",
    "warnings",
    "failures",
    "full_train_collection_complete",
    "final_holdout_accessed"
  ],
  "properties": {
    "collection_id": {"const": "bayesian-sequential-v1-full-train"},
    "collection_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scientific_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_prompt_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["incomplete", "pass", "failed"]},
    "expected_trace_count": {"const": 1620},
    "valid_trace_count": {"type": "integer", "minimum": 0, "maximum": 1620},
    "missing_trace_count": {"type": "integer", "minimum": 0, "maximum": 1620},
    "completion_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "valid_prompt_family_count": {"type": "integer", "minimum": 0, "maximum": 60},
    "valid_task_length_cell_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "by_stop_reason": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "by_task_length": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "by_temperature": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "by_seed": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "censoring_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "total_observed_tokens": {"type": "integer", "minimum": 0},
    "total_duration_ms": {"type": "number", "minimum": 0},
    "total_trace_bytes": {"type": "integer", "minimum": 0},
    "total_trace_gib": {"type": "number", "minimum": 0},
    "peak_cuda_allocated_bytes": {"type": "integer", "minimum": 0},
    "peak_cuda_reserved_bytes": {"type": "integer", "minimum": 0},
    "projected_remaining_duration_ms": {"type": "number", "minimum": 0},
    "new_trace_count_this_run": {"type": "integer", "minimum": 0, "maximum": 1620},
    "resumed_trace_count_this_run": {"type": "integer", "minimum": 0, "maximum": 1620},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "failures": {"type": "array", "items": {"type": "string"}},
    "full_train_collection_complete": {"type": "boolean"},
    "final_holdout_accessed": {"const": false}
  }
}
