{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bayesian-sequential-stage8-final-benchmark-v1",
  "title": "Bayesian Sequential one-time final holdout benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "status",
    "stage8a_config_sha256",
    "stage8b_lock_sha256",
    "checkpoint_registry_sha256",
    "final_holdout_manifest_sha256",
    "collection",
    "comparison_list",
    "primary_method",
    "metrics",
    "breakdowns",
    "uncertainty_cone",
    "convergence",
    "serving_replay",
    "statistical_comparisons",
    "model_selection_performed",
    "threshold_tuning_performed",
    "final_holdout_selects_nothing"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"const": "bayesian-sequential-v1-one-time-final-benchmark"},
    "status": {"enum": ["pass", "failed"]},
    "stage8a_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage8b_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "final_holdout_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "collection": {"type": "object"},
    "comparison_list": {"type": "array", "minItems": 7, "maxItems": 7},
    "primary_method": {"const": "bayesian_entropy_scalar_v1"},
    "metrics": {"type": "object"},
    "breakdowns": {"type": "object"},
    "uncertainty_cone": {"type": "object"},
    "convergence": {"type": "object"},
    "serving_replay": {"type": "object"},
    "statistical_comparisons": {"type": "object"},
    "model_selection_performed": {"const": false},
    "threshold_tuning_performed": {"const": false},
    "final_holdout_selects_nothing": {"const": true}
  }
}
