{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bayesian-sequential-stage7-error-feedback-v1",
  "title": "Bayesian Sequential Stage-7 Train-family OOF error feedback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage7_id",
    "status",
    "claim_scope",
    "config_sha256",
    "dataset_digest",
    "selected_method",
    "cohort_definition",
    "cohort_results",
    "failure_analysis",
    "sequence_audit_artifact",
    "manual_review_queue_artifact",
    "semantic_labels_are_not_automatically_resolved",
    "model_refit_performed",
    "method_reselection_performed",
    "threshold_tuning_performed",
    "changes_require_new_method_id",
    "final_holdout_accessed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "stage7_id": {"const": "bayesian-sequential-v1-stage7-oof-error-feedback"},
    "status": {"enum": ["pass", "failed"]},
    "claim_scope": {"const": "train_family_grouped_oof_failure_audit_not_final_holdout"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_method": {"const": "bayesian_entropy_scalar_v1"},
    "cohort_definition": {"type": "object"},
    "cohort_results": {"type": "object"},
    "failure_analysis": {"type": "object"},
    "sequence_audit_artifact": {"type": "string"},
    "manual_review_queue_artifact": {"type": "string"},
    "semantic_labels_are_not_automatically_resolved": {"const": true},
    "model_refit_performed": {"const": false},
    "method_reselection_performed": {"const": false},
    "threshold_tuning_performed": {"const": false},
    "changes_require_new_method_id": {"const": true},
    "final_holdout_accessed": {"const": false}
  }
}
