{
  "schema_version": 1,
  "protocol_id": "alps-plp-hybrid-v1-v2-development-2026",
  "status": "development_oof_before_new_holdout",
  "method_config": "configs/experiments/alps_plp_hybrid_v3.json",
  "data_policy": {
    "group_unit": "prompt_family_id",
    "train_oof_folds": 5,
    "inner_prior_crossfit_folds": 4,
    "fold_seed": 20260805,
    "all_seeds_lengths_and_timesteps_stay_with_family": true,
    "test_access": "forbidden_until_a_new_hybrid_holdout_is_authored"
  },
  "methods": {
    "alps_countdown": {
      "role": "static_prior_control"
    },
    "plp_terminal_zero_v3": {
      "role": "selected_plp_only_control",
      "hidden_dim": 3584,
      "terminal_zero_bin": true,
      "target_range_weighting": "unweighted_positive_targets"
    },
    "alps_plp_concat_v1": {
      "role": "feature_concatenation_hybrid",
      "hidden_dim": 1024,
      "terminal_zero_bin": true,
      "target_range_weighting": "rollout_balanced_positive_targets"
    },
    "alps_plp_residual_v2": {
      "role": "alps_countdown_plus_plp_residual_correction",
      "hidden_dim": 1024,
      "terminal_loss_weight": 0.2,
      "terminal_threshold": 0.5,
      "residual_loss": "smooth_l1",
      "residual_initialization": "zero_correction"
    }
  },
  "evaluation": {
    "primary_metric": "family_macro_sequence_balanced_mae_tokens",
    "absolute_step_bins": [1, 5, 10, 20, 50, 100, 200],
    "bootstrap": {
      "unit": "prompt_family_id",
      "replicates": 2000,
      "confidence_level": 0.95,
      "seed": 20260805,
      "paired": true
    },
    "familywise_comparisons": 5,
    "familywise_confidence_level": 0.99,
    "selection_rule": "select residual_v2 only if its familywise paired MAE CI versus concat_v1 is entirely below zero; otherwise retain concat_v1"
  },
  "outputs": {
    "run_root": "artifacts/runs/alps_plp_hybrid_versions",
    "oof_report": "oof/oof_report.json",
    "models": "models"
  }
}
