{
  "schema_version": 1,
  "contract_kind": "preimplementation_scientific_contract",
  "method_family": "bayesian-sequential-length-inference",
  "method_id": "bayesian-sequential-v1",
  "status": "phase1_approved_for_implementation",
  "authoritative_reference": {
    "path": "docs/references/大模型输出长度预测_2026-07-09_authoritative.pdf",
    "sha256": "b3c39e785a4a9217fd5d3c580b127c5a25093314f82bacb86f64f98feed02e62",
    "mathematical_contract": "docs/methods/bayesian_sequential_inference.md"
  },
  "base_experiment": "configs/experiments/alps_plp_hybrid_v3_base.json",
  "scientific_identity": {
    "role": "proposed_method",
    "question": "Does an ALPS prefill prior updated by non-overlapping decode evidence improve calibrated remaining-length inference?",
    "updates_model_parameters_online": false,
    "updates_request_posterior_online": true,
    "qwen_weights_frozen": true
  },
  "implementation": {
    "phase2_cpu_core_status": "complete",
    "completed_on": "2026-08-11",
    "real_qwen_trace_collected": false,
    "bayesian_experiments_started": false,
    "final_holdout_opened": false
  },
  "latent_state": {
    "name": "remaining_tokens_including_eos",
    "symbol": "R_t",
    "definition": "R_t = output_tokens - step",
    "support": "integer_tokens",
    "minimum": 0,
    "maximum_source": "generation.max_new_tokens - step",
    "overflow_state": "one_explicit_tail_state_for_total_length_greater_than_generation.max_new_tokens",
    "output_length_includes_eos": true,
    "terminal_state": 0
  },
  "prior": {
    "source": "alps_layer14_last_prompt_token",
    "target": "log1p_output_tokens",
    "distribution": "shifted_lognormal",
    "feature_layer_zero_based": 14,
    "ridge": {
      "standardize": true,
      "alpha": 1.0
    },
    "variance_source": "family_grouped_oof_log1p_residual_mle",
    "variance_fold_count": 5,
    "discretization": {
      "support_min_total_tokens": 1,
      "support_max_total_tokens": 4096,
      "method": "cdf_half_integer_mass",
      "renormalize_after_truncation": true,
      "preserve_upper_tail_as_overflow_state": true,
      "silent_tail_mass_drop_forbidden": true
    },
    "training_features": "inner_family_grouped_cross_fitted",
    "validation_features": "fit_on_outer_train_families_only"
  },
  "updates": {
    "saved_steps": "1_then_every_5_tokens_plus_terminal",
    "nominal_stride": 5,
    "transition": "shift_remaining_distribution_by_observed_delta_then_condition_on_survival",
    "transition_formula": "p_predict_t[r] proportional_to p_posterior_prev[r + delta]",
    "include_first_point": true,
    "include_terminal_point": true,
    "posterior_operations": "log_space",
    "normalization": "logsumexp"
  },
  "evidence": {
    "unit": "non_overlapping_new_token_block_since_previous_update",
    "overlapping_windows_as_independent_likelihood_forbidden": true,
    "full_causal_hidden_state_repeated_multiplication_forbidden": true,
    "prior_context_features": [
      "mu_log1p_total",
      "oof_calibrated_log_variance",
      "prior_mean_total_tokens"
    ],
    "time_features": [
      "step",
      "delta_step",
      "step_fraction_of_max_new_tokens"
    ],
    "block_features": [
      "last_entropy",
      "block_entropy_mean",
      "block_entropy_slope",
      "last_eos_probability",
      "block_max_eos_probability",
      "delta_entropy",
      "delta_eos_probability",
      "terminal_observed"
    ],
    "probability_source": "temperature_scaled_full_softmax_before_top_p",
    "candidate_features": [
      "remaining_tokens",
      "log1p_remaining_tokens",
      "remaining_fraction_of_max_new_tokens",
      "candidate_total_tokens",
      "overflow_indicator"
    ]
  },
  "candidate_models": {
    "bayesian_entropy_scalar_v1": {
      "role": "simplest_pdf_aligned_candidate",
      "uses_scalar_evidence": true,
      "uses_decode_hidden_delta": false
    },
    "bayesian_entropy_hidden_delta_v1": {
      "role": "pdf_hidden_state_extension",
      "uses_scalar_evidence": true,
      "uses_decode_hidden_delta": true,
      "hidden_input": "frozen_projection_of_decode_hidden_state_difference",
      "direct_7168_dimensional_concatenation": false
    }
  },
  "likelihood_ratio_head": {
    "output": "incremental_log_likelihood_ratio_per_candidate_remaining_length",
    "shared_candidate_scorer": true,
    "independent_output_parameter_per_integer_length": false,
    "direct_point_regression": false,
    "direct_posterior_without_prior": false
  },
  "posterior_update": {
    "formula": "log_posterior_t[r] = log_predict_t[r] + score_theta[e_t,r] - log_Z_t",
    "nonnegative_support_only": true,
    "mask_total_length_less_than_observed_step": true,
    "probability_sum_tolerance": 1e-06,
    "derive_discrete_hazard_from_posterior": true,
    "hazard_formula": "q_t[r] = p_t[r] / sum_u_ge_r p_t[u]"
  },
  "training": {
    "objective": "rollout_balanced_mean_step_posterior_nll",
    "terminal_bce_weight": 0.1,
    "posterior_total_variation_stability_weight": 0.01,
    "soft_labels_enabled": false,
    "optimizer": "adamw",
    "seed": 42,
    "device": "auto",
    "online_parameter_updates": false,
    "hyperparameter_selection_data": "train_family_grouped_oof_only"
  },
  "generation": {
    "model": "Qwen/Qwen2.5-7B-Instruct",
    "revision": "a09a35458c702b33eeacc393d103063234e8bc28",
    "primary_temperature": 0.7,
    "robustness_temperatures": [0.3, 1.0],
    "top_p": 0.95,
    "max_new_tokens": 4096,
    "seeds": [42, 43, 44],
    "temperature_is_model_input": false,
    "robustness_refit_forbidden": true
  },
  "data_policy": {
    "group_unit": "prompt_family_id",
    "outer_oof_folds": 5,
    "inner_prior_crossfit_folds": 4,
    "same_family_all_tasks_lengths_seeds_temperatures_and_steps_same_fold": true,
    "old_alps_plp_test_role": "historical_evidence_only",
    "new_final_holdout_required": true,
    "new_final_holdout_status": "not_authored_not_opened",
    "final_holdout_access": "forbidden_until_implementation_models_metrics_and_report_schema_are_frozen"
  },
  "censoring": {
    "definition": "stop_reason == max_new_tokens",
    "type": "right_censored",
    "impute_unknown_remaining_as_zero": false,
    "silent_drop_forbidden": true,
    "primary_likelihood": "right_censored_survival_contribution"
  },
  "baselines": [
    "prompt_token_ridge_countdown",
    "alps_countdown",
    "dynamic_signal_mlp_v1",
    "plp_terminal_zero_v3",
    "alps_plp_concat_v1"
  ],
  "evaluation": {
    "model_selection_primary_metric": "family_macro_sequence_balanced_posterior_nll",
    "probabilistic_metrics": [
      "posterior_nll",
      "crps",
      "interval_50_coverage",
      "interval_90_coverage",
      "interval_95_coverage",
      "interval_mean_width",
      "posterior_variance",
      "posterior_entropy"
    ],
    "point_metrics": [
      "mae_tokens",
      "rmse_tokens",
      "bias_tokens",
      "r_squared_tokens",
      "long_output_underestimation"
    ],
    "breakdowns": [
      "task",
      "intended_length",
      "task_by_intended_length",
      "temperature",
      "seed",
      "family_fold",
      "decode_progress",
      "terminal_vs_nonterminal"
    ],
    "convergence_metric": {
      "name": "stable_time_to_relative_error_5pct",
      "threshold": 0.05,
      "requires_all_later_saved_points_within_threshold": true,
      "never_reached": "censored_failure"
    },
    "uncertainty_cone_quantiles": [0.025, 0.5, 0.975],
    "report_online_update_wall_time": true,
    "report_peak_predictor_memory": true
  },
  "selection": {
    "comparison": "bayesian_entropy_hidden_delta_v1_minus_bayesian_entropy_scalar_v1",
    "unit": "prompt_family_id",
    "bootstrap_replicates": 2000,
    "confidence_level": 0.95,
    "seed": 20260810,
    "select_hidden_only_if_paired_nll_ci_entirely_below_zero": true,
    "otherwise_select": "bayesian_entropy_scalar_v1",
    "final_holdout_selects_nothing": true
  },
  "error_feedback": {
    "data": "train_family_grouped_oof_only",
    "absolute_error_threshold_tokens": 100,
    "worst_fraction": 0.05,
    "labels": [
      "entropy_rebound",
      "entropy_oscillation",
      "open_ended_prompt",
      "sampling_divergence",
      "repetition",
      "hallucination",
      "early_stop",
      "posterior_variance_increase",
      "posterior_premature_collapse",
      "posterior_oscillation"
    ],
    "changes_require_new_method_id": true
  },
  "outputs": {
    "trace_root": "data/interim/bayesian_sequential_v1",
    "run_root": "artifacts/runs/bayesian_sequential_v1",
    "report_root": "docs/results/bayesian_sequential"
  }
}
